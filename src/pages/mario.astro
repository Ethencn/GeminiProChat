---
// Mario-style Platform Game
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>马里奥风格游戏</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            overflow: hidden;
            background: linear-gradient(to bottom, #87CEEB 0%, #87CEEB 70%, #90EE90 70%, #90EE90 100%);
            font-family: 'Arial', sans-serif;
        }

        #gameCanvas {
            display: block;
            margin: 0 auto;
            background: linear-gradient(to bottom, #5c9fd6 0%, #5c9fd6 70%, #6fa86f 70%, #6fa86f 100%);
            box-shadow: 0 0 20px rgba(0,0,0,0.3);
        }

        #gameInfo {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 15px 30px;
            border-radius: 10px;
            font-size: 18px;
            display: flex;
            gap: 30px;
            z-index: 10;
        }

        #gameInfo div {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .game-over {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(0, 0, 0, 0.9);
            color: white;
            padding: 40px;
            border-radius: 20px;
            text-align: center;
            display: none;
            z-index: 20;
        }

        .game-over h1 {
            font-size: 48px;
            margin-bottom: 20px;
            color: #ff4444;
        }

        .game-over p {
            font-size: 24px;
            margin-bottom: 30px;
        }

        .game-over button {
            font-size: 20px;
            padding: 15px 40px;
            background: #4CAF50;
            color: white;
            border: none;
            border-radius: 10px;
            cursor: pointer;
            transition: background 0.3s;
        }

        .game-over button:hover {
            background: #45a049;
        }

        #instructions {
            position: absolute;
            bottom: 10px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 10px 20px;
            border-radius: 10px;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div id="gameInfo">
        <div>⭐ 得分: <span id="score">0</span></div>
        <div>❤️ 生命: <span id="lives">3</span></div>
        <div>🏆 关卡: <span id="level">1</span></div>
    </div>

    <div id="instructions">
        ⬅️➡️ 移动 | 空格 跳跃 | R 重新开始
    </div>

    <canvas id="gameCanvas" width="800" height="600"></canvas>

    <div id="gameOverScreen" class="game-over">
        <h1>游戏结束!</h1>
        <p>最终得分: <span id="finalScore">0</span></p>
        <button onclick="restartGame()">重新开始</button>
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // 游戏状态
        let gameRunning = true;
        let score = 0;
        let lives = 3;
        let level = 1;
        let keys = {};

        // 玩家对象
        const player = {
            x: 50,
            y: 400,
            width: 32,
            height: 32,
            velocityX: 0,
            velocityY: 0,
            speed: 5,
            jumpPower: 15,
            grounded: false,
            color: '#FF0000'
        };

        // 重力
        const gravity = 0.6;
        const maxFallSpeed = 20;

        // 平台数组
        let platforms = [];
        let enemies = [];
        let coins = [];

        // 初始化关卡
        function initLevel(levelNum) {
            platforms = [];
            enemies = [];
            coins = [];

            // 地面
            platforms.push({
                x: 0,
                y: 550,
                width: 800,
                height: 50,
                color: '#8B4513'
            });

            if (levelNum === 1) {
                // 第一关的平台
                platforms.push(
                    { x: 200, y: 450, width: 100, height: 20, color: '#654321' },
                    { x: 350, y: 380, width: 100, height: 20, color: '#654321' },
                    { x: 500, y: 310, width: 100, height: 20, color: '#654321' },
                    { x: 650, y: 240, width: 100, height: 20, color: '#654321' }
                );

                // 敌人
                enemies.push(
                    { x: 300, y: 518, width: 30, height: 30, velocityX: 2, color: '#8B008B' },
                    { x: 550, y: 518, width: 30, height: 30, velocityX: -2, color: '#8B008B' }
                );

                // 金币
                coins.push(
                    { x: 240, y: 410, width: 20, height: 20, collected: false },
                    { x: 390, y: 340, width: 20, height: 20, collected: false },
                    { x: 540, y: 270, width: 20, height: 20, collected: false },
                    { x: 690, y: 200, width: 20, height: 20, collected: false }
                );
            } else if (levelNum === 2) {
                // 第二关 - 更难
                platforms.push(
                    { x: 150, y: 480, width: 80, height: 20, color: '#654321' },
                    { x: 280, y: 420, width: 80, height: 20, color: '#654321' },
                    { x: 410, y: 360, width: 80, height: 20, color: '#654321' },
                    { x: 540, y: 300, width: 80, height: 20, color: '#654321' },
                    { x: 670, y: 240, width: 80, height: 20, color: '#654321' },
                    { x: 350, y: 180, width: 100, height: 20, color: '#654321' }
                );

                enemies.push(
                    { x: 200, y: 518, width: 30, height: 30, velocityX: 3, color: '#8B008B' },
                    { x: 400, y: 518, width: 30, height: 30, velocityX: -3, color: '#8B008B' },
                    { x: 600, y: 518, width: 30, height: 30, velocityX: 2, color: '#8B008B' }
                );

                coins.push(
                    { x: 170, y: 440, width: 20, height: 20, collected: false },
                    { x: 300, y: 380, width: 20, height: 20, collected: false },
                    { x: 430, y: 320, width: 20, height: 20, collected: false },
                    { x: 560, y: 260, width: 20, height: 20, collected: false },
                    { x: 690, y: 200, width: 20, height: 20, collected: false },
                    { x: 400, y: 140, width: 20, height: 20, collected: false }
                );
            }

            // 重置玩家位置
            player.x = 50;
            player.y = 400;
            player.velocityX = 0;
            player.velocityY = 0;
        }

        // 键盘事件监听
        document.addEventListener('keydown', (e) => {
            keys[e.code] = true;

            if (e.code === 'Space' && player.grounded) {
                player.velocityY = -player.jumpPower;
                player.grounded = false;
            }

            if (e.code === 'KeyR') {
                restartGame();
            }
        });

        document.addEventListener('keyup', (e) => {
            keys[e.code] = false;
        });

        // 碰撞检测
        function checkCollision(rect1, rect2) {
            return rect1.x < rect2.x + rect2.width &&
                   rect1.x + rect1.width > rect2.x &&
                   rect1.y < rect2.y + rect2.height &&
                   rect1.y + rect1.height > rect2.y;
        }

        // 更新玩家
        function updatePlayer() {
            // 左右移动
            if (keys['ArrowLeft']) {
                player.velocityX = -player.speed;
            } else if (keys['ArrowRight']) {
                player.velocityX = player.speed;
            } else {
                player.velocityX = 0;
            }

            // 应用重力
            player.velocityY += gravity;
            if (player.velocityY > maxFallSpeed) {
                player.velocityY = maxFallSpeed;
            }

            // 更新位置
            player.x += player.velocityX;
            player.y += player.velocityY;

            // 边界检测
            if (player.x < 0) player.x = 0;
            if (player.x + player.width > canvas.width) {
                player.x = canvas.width - player.width;
            }

            // 默认不在地面
            player.grounded = false;

            // 平台碰撞检测
            platforms.forEach(platform => {
                if (checkCollision(player, platform)) {
                    // 从上方落到平台上
                    if (player.velocityY > 0 && player.y + player.height - player.velocityY <= platform.y) {
                        player.y = platform.y - player.height;
                        player.velocityY = 0;
                        player.grounded = true;
                    }
                    // 从下方撞到平台
                    else if (player.velocityY < 0 && player.y - player.velocityY >= platform.y + platform.height) {
                        player.y = platform.y + platform.height;
                        player.velocityY = 0;
                    }
                    // 从侧面碰撞
                    else {
                        if (player.velocityX > 0) {
                            player.x = platform.x - player.width;
                        } else if (player.velocityX < 0) {
                            player.x = platform.x + platform.width;
                        }
                    }
                }
            });

            // 掉出屏幕
            if (player.y > canvas.height) {
                lives--;
                if (lives > 0) {
                    player.x = 50;
                    player.y = 400;
                    player.velocityY = 0;
                } else {
                    gameOver();
                }
            }
        }

        // 更新敌人
        function updateEnemies() {
            enemies.forEach(enemy => {
                enemy.x += enemy.velocityX;

                // 边界反弹
                if (enemy.x < 0 || enemy.x + enemy.width > canvas.width) {
                    enemy.velocityX *= -1;
                }

                // 玩家碰到敌人
                if (checkCollision(player, enemy)) {
                    // 从上方跳到敌人身上
                    if (player.velocityY > 0 && player.y + player.height - 10 < enemy.y) {
                        score += 100;
                        enemy.x = -100; // 移出屏幕
                        player.velocityY = -10; // 弹起
                    } else {
                        // 受伤
                        lives--;
                        if (lives > 0) {
                            player.x = 50;
                            player.y = 400;
                            player.velocityY = 0;
                        } else {
                            gameOver();
                        }
                    }
                }
            });
        }

        // 更新金币
        function updateCoins() {
            coins.forEach(coin => {
                if (!coin.collected && checkCollision(player, coin)) {
                    coin.collected = true;
                    score += 50;
                }
            });

            // 检查是否收集完所有金币
            const allCollected = coins.every(coin => coin.collected);
            if (allCollected && coins.length > 0) {
                nextLevel();
            }
        }

        // 下一关
        function nextLevel() {
            level++;
            if (level > 2) {
                level = 1; // 循环关卡
            }
            initLevel(level);
        }

        // 绘制玩家
        function drawPlayer() {
            ctx.fillStyle = player.color;
            ctx.fillRect(player.x, player.y, player.width, player.height);

            // 眼睛
            ctx.fillStyle = 'white';
            ctx.fillRect(player.x + 8, player.y + 8, 6, 6);
            ctx.fillRect(player.x + 18, player.y + 8, 6, 6);

            ctx.fillStyle = 'black';
            ctx.fillRect(player.x + 10, player.y + 10, 3, 3);
            ctx.fillRect(player.x + 20, player.y + 10, 3, 3);
        }

        // 绘制平台
        function drawPlatforms() {
            platforms.forEach(platform => {
                ctx.fillStyle = platform.color;
                ctx.fillRect(platform.x, platform.y, platform.width, platform.height);

                // 添加纹理效果
                ctx.strokeStyle = '#000';
                ctx.lineWidth = 2;
                ctx.strokeRect(platform.x, platform.y, platform.width, platform.height);
            });
        }

        // 绘制敌人
        function drawEnemies() {
            enemies.forEach(enemy => {
                ctx.fillStyle = enemy.color;
                ctx.fillRect(enemy.x, enemy.y, enemy.width, enemy.height);

                // 眼睛
                ctx.fillStyle = 'red';
                ctx.fillRect(enemy.x + 5, enemy.y + 8, 6, 6);
                ctx.fillRect(enemy.x + 19, enemy.y + 8, 6, 6);
            });
        }

        // 绘制金币
        function drawCoins() {
            coins.forEach(coin => {
                if (!coin.collected) {
                    ctx.fillStyle = '#FFD700';
                    ctx.beginPath();
                    ctx.arc(coin.x + coin.width/2, coin.y + coin.height/2, coin.width/2, 0, Math.PI * 2);
                    ctx.fill();

                    ctx.strokeStyle = '#FFA500';
                    ctx.lineWidth = 2;
                    ctx.stroke();
                }
            });
        }

        // 绘制背景
        function drawBackground() {
            // 天空
            ctx.fillStyle = '#5c9fd6';
            ctx.fillRect(0, 0, canvas.width, canvas.height * 0.7);

            // 草地
            ctx.fillStyle = '#6fa86f';
            ctx.fillRect(0, canvas.height * 0.7, canvas.width, canvas.height * 0.3);

            // 云朵
            drawCloud(100, 80);
            drawCloud(300, 120);
            drawCloud(600, 60);
        }

        function drawCloud(x, y) {
            ctx.fillStyle = 'rgba(255, 255, 255, 0.8)';
            ctx.beginPath();
            ctx.arc(x, y, 20, 0, Math.PI * 2);
            ctx.arc(x + 25, y, 25, 0, Math.PI * 2);
            ctx.arc(x + 50, y, 20, 0, Math.PI * 2);
            ctx.fill();
        }

        // 更新UI
        function updateUI() {
            document.getElementById('score').textContent = score;
            document.getElementById('lives').textContent = lives;
            document.getElementById('level').textContent = level;
        }

        // 游戏结束
        function gameOver() {
            gameRunning = false;
            document.getElementById('finalScore').textContent = score;
            document.getElementById('gameOverScreen').style.display = 'block';
        }

        // 重新开始游戏
        function restartGame() {
            gameRunning = true;
            score = 0;
            lives = 3;
            level = 1;
            initLevel(1);
            document.getElementById('gameOverScreen').style.display = 'none';
            gameLoop();
        }

        // 游戏主循环
        function gameLoop() {
            if (!gameRunning) return;

            // 清空画布
            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // 绘制
            drawBackground();
            drawPlatforms();
            drawCoins();
            drawEnemies();
            drawPlayer();

            // 更新
            updatePlayer();
            updateEnemies();
            updateCoins();
            updateUI();

            // 下一帧
            requestAnimationFrame(gameLoop);
        }

        // 初始化并开始游戏
        initLevel(1);
        gameLoop();

        // 全局函数供按钮调用
        window.restartGame = restartGame;
    </script>
</body>
</html>
